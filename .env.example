# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase project ref (the chunk before .supabase.co). Used by `npm run types:gen`.
SUPABASE_PROJECT_ID=

# OpenAI (Platform > API Keys)
OPENAI_API_KEY=

# Public app URL (no trailing slash). Used for OAuth redirect.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Comma-separated list of emails allowed into /admin (PM dashboard).
# Leave empty to disable the admin surface entirely.
ADMIN_EMAILS=
